#!/bin/bash
set -u

port=$1
idle=$2
key_file=$3
base="http://127.0.0.1:$port"
unsloth="$HOME/.local/bin/unsloth"

"$unsloth" studio --api-only --disable-tools --parallel 1 -p "$port" &
studio=$!

until curl -fs -m 2 -o /dev/null "$base/api/health"; do
  kill -0 "$studio" 2>/dev/null || exit 1
  sleep 0.5
done

auth="Authorization: Bearer $(cat "$key_file")"
curl -fs -m 10 -o /dev/null -X PUT -H "$auth" -H 'Content-Type: application/json' \
  -d "{\"enabled\":true,\"auto_unload_idle_seconds\":$idle}" \
  "$base/api/settings/openai-auto-switch"

(
  last_loaded=$SECONDS
  while sleep 30; do
    if curl -fs -m 10 -H "$auth" "$base/v1/models" | grep -q '"loaded":true'; then
      last_loaded=$SECONDS
    elif ((SECONDS - last_loaded >= 120)); then
      "$unsloth" studio stop
    fi
  done
) &
monitor=$!

wait "$studio"
pkill -P "$monitor"
kill "$monitor"
